# ============================================
# VIBECONNECT ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your actual values

# ============================================
# DATABASE CONFIGURATION
# ============================================
# MongoDB connection string
# Format: mongodb+srv://username:password@cluster.mongodb.net/database_name
# Get this from MongoDB Atlas: https://www.mongodb.com/cloud/atlas
MONGO_URL=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/vibeconnect?retryWrites=true&w=majority

# ============================================
# AUTHENTICATION
# ============================================
# JWT Secret for token signing (use a strong random string)
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# ============================================
# SERVER CONFIGURATION
# ============================================
# Server port
PORT=3001

# ============================================
# CORS & SECURITY
# ============================================
# Comma-separated list of allowed origins for CORS
# For local development: http://localhost:3000,http://localhost:3001
# For production: https://yourdomain.com,https://api.yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================
# FILE UPLOAD PATHS
# ============================================
# Assets directory (where uploaded files are stored)
# Default: public/assets (created automatically if doesn't exist)
ASSETS_PATH=public/assets

# ============================================
# OPTIONAL: LOGGING
# ============================================
# Set to 'debug' for detailed logging, 'info' for normal, 'error' for errors only
LOG_LEVEL=info

# ============================================
# OPTIONAL: NODE ENVIRONMENT
# ============================================
# Set to 'production', 'development', or 'test'
NODE_ENV=development
